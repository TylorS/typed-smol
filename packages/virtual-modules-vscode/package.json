{
  "name": "@typed/virtual-modules-vscode",
  "displayName": "Typed Virtual Modules",
  "version": "1.0.0-beta.4",
  "publisher": "typed",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/extension.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "pnpm --filter @typed/virtual-modules run build",
    "build": "esbuild src/extension.ts --bundle --format=cjs --outfile=dist/extension.js --external:vscode --platform=node",
    "build:extension": "pnpm run build && node scripts/package-vsix.mjs",
    "compile": "npm run build",
    "pretest": "pnpm --filter @typed/virtual-modules run build",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@typed/virtual-modules": "workspace:*"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.7.0",
    "@types/node": "^25.7.0",
    "@types/vscode": "^1.118.0",
    "esbuild": "^0.28.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "typed.virtualModules.open",
        "title": "Virtual Modules: Open virtual module"
      },
      {
        "command": "typed.virtualModules.openFromImport",
        "title": "Virtual Modules: Open virtual module from import"
      },
      {
        "command": "typed.virtualModules.openFromTree",
        "title": "Virtual Modules: Open virtual module from tree"
      },
      {
        "command": "typed.virtualModules.refresh",
        "title": "Refresh Virtual Modules"
      },
      {
        "command": "typed.virtualModules.diagnoseDefinition",
        "title": "Virtual Modules: Diagnose go-to-definition at cursor"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "typed.virtualModules.openFromImport",
          "when": "editorTextFocus",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "typed.virtualModules.refresh",
          "when": "view == typedVirtualModules",
          "group": "navigation"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "typedVirtualModules",
          "name": "Virtual Module Imports"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "typedVirtualModules",
        "contents": "No virtual modules found. Add imports like `import x from 'virtual:foo'` in your TypeScript files."
      }
    ]
  },
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "engines": {
    "vscode": "^1.74.0"
  }
}
