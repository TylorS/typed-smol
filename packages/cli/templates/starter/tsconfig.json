{
  "extends": "@typed/tsconfig/dom",
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "outDir": "./dist/types",
    "rootDir": ".",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@__APP_NAME__/shared": ["packages/shared/src/index.ts"]
    },
    "plugins": [
      {
        "name": "@typed/virtual-modules-ts-plugin",
        "vmcConfigPath": "./vmc.config.ts"
      }
    ]
  },
  "include": ["packages/**/*.ts", "typed.config.ts", "vmc.config.ts", "vite.config.ts"],
  "exclude": ["dist", "node_modules"]
}
