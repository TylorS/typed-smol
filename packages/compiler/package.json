{
  "name": "@typed/compiler",
  "version": "1.0.0-beta.4",
  "files": ["dist", "src"],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "[ -d dist ] || rm -f tsconfig.tsbuildinfo; tsc",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@typed/fx": "workspace:*",
    "@typed/template": "workspace:*",
    "@typed/virtual-modules": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  }
}
