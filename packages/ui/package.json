{
  "name": "@typed/ui",
  "version": "1.0.0-beta.4",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "[ -d dist ] || rm -f tsconfig.tsbuildinfo; tsc",
    "lint": "oxlint src --deny-warnings",
    "test": "pnpm run lint && pnpm run test:typecheck && vitest run --passWithNoTests",
    "test:typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@typed/fx": "workspace:*",
    "@typed/id": "workspace:*",
    "@typed/navigation": "workspace:*",
    "@typed/router": "workspace:*",
    "@typed/template": "workspace:*",
    "effect": "catalog:",
    "happy-dom": "catalog:"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
