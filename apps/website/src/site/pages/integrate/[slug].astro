---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Article from "../../layouts/Article.astro";
import { groupRecipes } from "../../Recipes.js";
export async function getStaticPaths() {
  return groupRecipes(await getCollection("recipes")).flatMap(
    ({ title, entries }) =>
      entries.map((entry, index) => ({
        params: { slug: entry.data.slug },
        props: {
          entry,
          family: title,
          previous: entries[index - 1],
          next: entries[index + 1],
        },
      })),
  );
}
interface Props {
  entry: CollectionEntry<"recipes">;
  family: string;
  previous?: CollectionEntry<"recipes">;
  next?: CollectionEntry<"recipes">;
}
const { entry, family, previous, next } = Astro.props;
const link = (entry?: CollectionEntry<"recipes">) =>
  entry && { href: `/integrate/${entry.data.slug}`, title: entry.data.title };
const { Content, headings } = await render(entry);
---

<Article
  title={entry.data.title}
  summary={entry.data.summary}
  section={family}
  current={`integrate/${entry.data.slug}`}
  index={{ href: "/integrate", title: "All integrations" }}
  previous={link(previous)}
  next={link(next)}
  headings={headings}
  source={`content/recipes/${entry.id}.md`}><Content /></Article
>
