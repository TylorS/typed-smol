---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Article from "../../layouts/Article.astro";
import UiCatalog from "../../components/UiCatalog.astro";

export async function getStaticPaths() {
  const guides = (await getCollection("guides")).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return guides.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, previous: guides[index - 1], next: guides[index + 1] },
  }));
}
interface Props {
  entry: CollectionEntry<"guides">;
  previous?: CollectionEntry<"guides">;
  next?: CollectionEntry<"guides">;
}
const { entry, previous, next } = Astro.props;
const { Content, headings } = await render(entry);
const link = (entry?: CollectionEntry<"guides">) =>
  entry && { href: `/explore/${entry.id}`, title: entry.data.title };
---

<Article
  {...entry.data}
  current={entry.id}
  headings={headings}
  source={`content/guides/${entry.id}.md`}
  previous={link(previous)}
  next={link(next)}
  ><Content />{entry.id === "choosing-ui-components" && <UiCatalog />}</Article
>
