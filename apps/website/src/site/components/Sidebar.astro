---
import { getCollection } from "astro:content";
import { siteHref } from "../../SiteHref.js";
import { groupGuides } from "../Guides.js";
import { groupRecipes } from "../Recipes.js";

interface Props {
  current?: string;
}
const { current } = Astro.props;
const integrations = groupRecipes(await getCollection("recipes"));
const starters = [
  ["cooperative-by-design", "Cooperative by design"],
  ["quick-start", "Quick Start"],
  ["tutorial", "Build TodoMVC"],
  ["ui", "Learn every UI primitive"],
  ["storybook", "UI Storybook"],
  ["fx-operator-atlas", "Fx marble atlas"],
];
const featured = new Set(starters.map(([slug]) => slug));
const groups = groupGuides(await getCollection("guides"))
  .map(
    ([section, entries]) =>
      [section, entries.filter(({ id }) => !featured.has(id))] as const,
  )
  .filter(([, entries]) => entries.length > 0);
---

<nav aria-label="Documentation" data-docs-navigation>
  <div class="sidebar-group">
    <h2>Start building</h2>
    {
      starters.map(([slug, title]) => (
        <a
          href={siteHref(`/explore/${slug}`)}
          aria-current={current === slug ? "page" : undefined}
        >
          {title}
        </a>
      ))
    }
  </div>
  {
    [...groups].map(([section, entries]) => (
      <details
        class="sidebar-group"
        open={
          section === "Learning paths" ||
          entries.some(({ id }) => id === current)
        }
      >
        <summary>
          {section} <span>{entries.length}</span>
        </summary>
        {entries.map((entry) => (
          <a
            href={siteHref(`/explore/${entry.id}`)}
            aria-current={current === entry.id ? "page" : undefined}
          >
            {entry.data.title}
          </a>
        ))}
      </details>
    ))
  }
  {
    current?.startsWith("integrate/") &&
      integrations.map(({ title, entries }) => (
        <details
          class="sidebar-group"
          open={entries.some(
            ({ data }) => current === `integrate/${data.slug}`,
          )}
        >
          <summary>{title}</summary>
          {entries.map(({ data }) => (
            <a
              href={siteHref(`/integrate/${data.slug}`)}
              aria-current={
                current === `integrate/${data.slug}` ? "page" : undefined
              }
            >
              {data.title}
            </a>
          ))}
        </details>
      ))
  }
  <div class="sidebar-group">
    <h2>Keep close</h2>
    <a href={siteHref("/reference")}>All packages and APIs</a>
    <a href={siteHref("/integrate")}>Integrations and browser APIs</a>
    <a href="https://effect.website/docs/v4/">Effect v4 ↗</a>
  </div>
</nav>
