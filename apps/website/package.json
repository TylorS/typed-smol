{
  "name": "typed-website",
  "version": "0.0.0",
  "private": true,
  "description": "Typed marketing, reference, and agent documentation website",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm docs:generate && pnpm build:static",
    "build:client": "vite build && pnpm stage:public",
    "build:server": "vite build --ssr src/server.ts",
    "build:preview": "pnpm build:client && pnpm build:server",
    "clean:dist": "tsx scripts/clean-dist.ts",
    "build:static": "pnpm clean:dist && pnpm build:preview && tsx scripts/static/build.ts",
    "start": "node dist/server/server.js",
    "docs:dependencies": "node node_modules/typescript-compiler/bin/tsc -b ../../tsconfig.build.json",
    "docs:generate": "pnpm docs:dependencies && tsx scripts/generate-docs.ts",
    "stage:public": "tsx scripts/static/stage-public.ts",
    "test": "pnpm test:production",
    "test:static": "node --test test/static-site.test.mjs",
    "test:docs": "pnpm docs:dependencies && vitest run --config vitest.config.ts src/docs/__tests__",
    "test:production": "pnpm build && node --test test/production-smoke.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@typed/fx": "workspace:*",
    "@typed/guard": "workspace:*",
    "@typed/id": "workspace:*",
    "@typed/navigation": "workspace:*",
    "@typed/router": "workspace:*",
    "@typed/template": "workspace:*",
    "@typed/ui": "workspace:*",
    "effect": "catalog:",
    "marked": "18.0.11",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.111",
    "@typed/tsconfig": "workspace:*",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "happy-dom": "catalog:",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "svelte": "catalog:",
    "svelte2tsx": "0.7.61",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-compiler": "npm:typescript@6.0.3",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "^3.5.42"
  }
}
