{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/**/*.stories.ts",
    "src/common/routeData.ts",
    "src/common/components/**/*.ts",
    "src/routes/**/*.ts",
    "src/api/**/*.ts",
    ".storybook/**/*.ts"
  ],
  "exclude": ["dist", "node_modules", "src/tests", "src/Api.ts", "src/.browser.dependencies.ts"]
}
