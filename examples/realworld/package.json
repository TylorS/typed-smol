{
  "name": "typed-realworld",
  "version": "0.0.0",
  "private": true,
  "description": "Full-stack RealWorld example for @typed/app.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:unit": "vitest run --passWithNoTests src/tests/package.test.ts src/tests/domain",
    "test:integration": "vitest run --passWithNoTests src/tests/infrastructure src/tests/application src/tests/api",
    "test:ssr": "vitest run --passWithNoTests src/tests/presentation",
    "test:e2e:local": "node -e \"console.error('Task 12 will wire local Playwright E2E automation.'); process.exit(1);\"",
    "test:api:hurl:local": "node -e \"console.error('Task 12 will wire local Hurl API automation.'); process.exit(1);\"",
    "db:migrate": "node -e \"console.error('Task 4 will wire SQLite migrations.'); process.exit(1);\"",
    "db:seed": "node -e \"console.error('Task 4 will wire deterministic seed data.'); process.exit(1);\"",
    "db:reset": "node -e \"console.error('Task 4 will wire SQLite reset/migrate/seed.'); process.exit(1);\""
  },
  "dependencies": {
    "@effect/sql-sqlite-node": "4.0.0-beta.66",
    "@typed/app": "workspace:*",
    "@typed/async-data": "workspace:*",
    "@typed/fx": "workspace:*",
    "@typed/guard": "workspace:*",
    "@typed/navigation": "workspace:*",
    "@typed/router": "workspace:*",
    "@typed/template": "workspace:*",
    "@typed/ui": "workspace:*",
    "effect": "catalog:",
    "micromark": "4.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@typed/tsconfig": "workspace:*",
    "@typed/vite-plugin": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.17.1"
}
