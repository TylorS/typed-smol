{
  "name": "typed-realworld",
  "version": "0.0.0",
  "private": true,
  "description": "Full-stack RealWorld example for @typed/app.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "typed dev",
    "build": "typed build",
    "preview": "typed preview",
    "check": "typed check",
    "typecheck": "typed check",
    "test": "typed test",
    "test:unit": "vitest run --passWithNoTests src/tests/package.test.ts src/tests/domain",
    "test:integration": "vitest run --passWithNoTests src/tests/infrastructure src/tests/application src/tests/api",
    "test:ssr": "vitest run --passWithNoTests src/tests/presentation",
    "test:acceptance:local": "vmc -p tsconfig.json && node dist/types/scripts/run-acceptance-local.js",
    "test:e2e:local": "vmc -p tsconfig.json && node dist/types/scripts/run-e2e-local.js",
    "test:hmr:local": "node scripts/run-hmr-local.js",
    "test:api:hurl:local": "vmc -p tsconfig.json && node dist/types/scripts/run-hurl-local.js",
    "db:migrate": "vmc -p tsconfig.json && node dist/types/scripts/db.js migrate",
    "db:seed": "vmc -p tsconfig.json && node dist/types/scripts/db.js seed",
    "db:reset": "vmc -p tsconfig.json && node dist/types/scripts/db.js reset",
    "storybook": "pnpm --filter @typed/app build && pnpm --filter @typed/vite-plugin build && pnpm --filter @typed/storybook build && storybook dev --config-dir .storybook --port 6006",
    "storybook:build": "pnpm --filter @typed/app build && pnpm --filter @typed/vite-plugin build && pnpm --filter @typed/storybook build && storybook build --config-dir .storybook --output-dir dist/storybook",
    "typecheck:stories": "pnpm storybook:build"
  },
  "dependencies": {
    "@effect/sql-sqlite-node": "4.0.0-beta.66",
    "@typed/app": "workspace:*",
    "@typed/async-data": "workspace:*",
    "@typed/fx": "workspace:*",
    "@typed/guard": "workspace:*",
    "@typed/navigation": "workspace:*",
    "@typed/router": "workspace:*",
    "@typed/template": "workspace:*",
    "@typed/ui": "workspace:*",
    "effect": "catalog:",
    "micromark": "4.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@storybook/builder-vite": "10.4.1",
    "@typed/cli": "workspace:*",
    "@typed/storybook": "workspace:*",
    "@typed/tsconfig": "workspace:*",
    "@typed/virtual-modules-compiler": "workspace:*",
    "@typed/virtual-modules-ts-plugin": "workspace:*",
    "@typed/vite-plugin": "workspace:*",
    "@types/node": "^25.7.0",
    "happy-dom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "storybook": "10.4.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.17.1"
}
